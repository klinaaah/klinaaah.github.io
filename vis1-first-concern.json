{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data1-first-concern.json"
  },
  "params": [
    {
      "name": "reporter_select",
      "value": "All",
      "bind": {"input": "select", "options": ["All", "Parent/caregiver", "Teacher", "Self-reflection"], "name": "Reporter: "}
    }
  ],
  "transform": [
    {"filter": "reporter_select == 'All' || datum.reporter == reporter_select"}
  ],
  "mark": "bar",
  "encoding": {
    "x": {"field": "age", "type": "ordinal", "title": "Age at first concern", "sort": ["1-2", "3-4", "5-6", "7-9", "10+"]},
    "y": {"field": "count", "type": "quantitative", "title": "Illustrative number of cases"},
    "color": {"field": "reporter", "type": "nominal", "title": "Reporter"},
    "tooltip": [
      {"field": "reporter", "type": "nominal"},
      {"field": "age", "type": "ordinal", "title": "Age"},
      {"field": "count", "type": "quantitative", "title": "Cases"}
    ]
  }
}
