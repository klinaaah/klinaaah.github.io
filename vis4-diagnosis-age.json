{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "values": [
      {"age": "2-4", "count": 34, "profile": "Early-identified"},
      {"age": "5-7", "count": 28, "profile": "Early-identified"},
      {"age": "8-10", "count": 10, "profile": "Early-identified"},
      {"age": "11-14", "count": 4, "profile": "Early-identified"},
      {"age": "15-18", "count": 2, "profile": "Early-identified"},
      {"age": "19+", "count": 1, "profile": "Early-identified"},

      {"age": "2-4", "count": 6, "profile": "School-age identified"},
      {"age": "5-7", "count": 24, "profile": "School-age identified"},
      {"age": "8-10", "count": 30, "profile": "School-age identified"},
      {"age": "11-14", "count": 22, "profile": "School-age identified"},
      {"age": "15-18", "count": 10, "profile": "School-age identified"},
      {"age": "19+", "count": 4, "profile": "School-age identified"},

      {"age": "2-4", "count": 1, "profile": "Late-identified"},
      {"age": "5-7", "count": 3, "profile": "Late-identified"},
      {"age": "8-10", "count": 6, "profile": "Late-identified"},
      {"age": "11-14", "count": 14, "profile": "Late-identified"},
      {"age": "15-18", "count": 24, "profile": "Late-identified"},
      {"age": "19+", "count": 36, "profile": "Late-identified"}
    ]
  },
  "params": [
    {
      "name": "profile_select",
      "value": "All profiles",
      "bind": {"input": "select", "options": ["All profiles", "Early-identified", "School-age identified", "Late-identified"], "name": "Presentation profile: "}
    }
  ],
  "transform": [
    {"filter": "profile_select == 'All profiles' || datum.profile == profile_select"}
  ],
  "mark": "bar",
  "encoding": {
    "x": {"field": "age", "type": "ordinal", "title": "Age at diagnosis", "sort": ["2-4", "5-7", "8-10", "11-14", "15-18", "19+"]},
    "y": {"field": "count", "type": "quantitative", "title": "Illustrative number of cases"},
    "color": {"field": "profile", "type": "nominal", "title": "Profile"},
    "tooltip": [
      {"field": "profile", "type": "nominal"},
      {"field": "age", "type": "ordinal", "title": "Age"},
      {"field": "count", "type": "quantitative", "title": "Cases"}
    ]
  }
}
