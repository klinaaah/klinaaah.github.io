{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/data3-assessment.json"
  },
  "params": [
    {
      "name": "age_select",
      "value": "Children",
      "bind": {"input": "select", "options": ["Children", "Adolescents", "Adults"], "name": "Age band: "}
    }
  ],
  "transform": [
    {"filter": "datum.ageBand == age_select"}
  ],
  "mark": "bar",
  "encoding": {
    "y": {"field": "component", "type": "nominal", "title": "Assessment component", "sort": null},
    "x": {"field": "count", "type": "quantitative", "title": "Illustrative share (%)", "stack": "normalize"},
    "color": {"field": "status", "type": "nominal", "title": "Status", "scale": {"range": ["#4c78a8", "#e0e0e0"]}},
    "tooltip": [
      {"field": "ageBand", "type": "nominal", "title": "Age band"},
      {"field": "component", "type": "nominal"},
      {"field": "status", "type": "nominal"},
      {"field": "count", "type": "quantitative", "title": "Value"}
    ]
  }
}
