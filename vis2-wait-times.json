{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data2-wait-times.json"
  },
  "params": [
    {
      "name": "service_select",
      "value": "All services",
      "bind": {"input": "select", "options": ["All services", "Community clinic", "Hospital team", "Private provider"], "name": "Service type: "}
    }
  ],
  "transform": [
    {"filter": "service_select == 'All services' || datum.service == service_select"}
  ],
  "mark": {"type": "line", "point": true},
  "encoding": {
    "x": {"field": "year", "type": "ordinal", "title": "Referral year"},
    "y": {"field": "months", "type": "quantitative", "title": "Average wait (months)"},
    "color": {"field": "service", "type": "nominal", "title": "Service"},
    "tooltip": [
      {"field": "service", "type": "nominal"},
      {"field": "year", "type": "ordinal"},
      {"field": "months", "type": "quantitative", "title": "Months"}
    ]
  }
}
